+   if tbptt and t and t%tbptt==0:
+    s=dict(s);s.update({k:s[k].detach() for k in ['s','dk','dv']})
+   if stream_encoder:y,s=self.step(x[:,t],s)
+   else:y,s=self.decode(e[:,t],s,mk[:,:,:t+1],mv[:,:,:t+1],t)
+   out.append(y)
